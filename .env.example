
TELEGRAM_TOKEN=from-@BotFather
TELEGRAM_CHAT_ID=from-@userinfobot
WEB_TOKEN=make-up-a-long-random-string
TF=1h
TOP_N=200
MAX_POSITIONS=10
DEMO=true
# --- стратегия SK 0->A->B (только лонг, спот) ---
# сигнал: касание зоны B (0.5-0.786 от импульса 0->A). Режим входа:
# ENTRY_MODE=zone (вход в зоне B) | ENTRY_MODE=act (вход на пробое A)
ENTRY_MODE=zone
ENTRY_USD=100
CAPITAL_USD=1000
# money management: TP1 +2% на 30%, TP2 (1.618) закрывает 100% позиции
TP1_PCT=2.0
TP1_FRAC=0.30
# структура
MIN_IMPULSE_ATR=1.5
ZONE_MIN=0.5
ZONE_MAX=0.786
LIFE_ACTIVE=150
# параметры можно менять налету в data/config.json (веб-дашборд)

# web admin (created on first boot)
ADMIN_EMAIL=admin@sk.local
ADMIN_PASSWORD=change-me-strong
